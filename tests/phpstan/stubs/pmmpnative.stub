 * @param list<float> $kernel
 * @param list<int> $terrain_blocks
 *
 * @return array{int|array{int, string, list<int>}, array<int, int|array{int, string, list<int>}>}|null
 */
function pmmp_native_normal_chunk(array $noise, array $temperature, array $rainfall, array $biome_map, array $biomes, int $seed, int $base_x, int $base_z, int $water_height, array $kernel, float $weight_sum, array $terrain_blocks) : ?array{}

